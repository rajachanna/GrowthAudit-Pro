{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    { "source": "/", "destination": "/web/index.html" },
    { "source": "/growth-audit", "destination": "/web/index.html" },
    { "source": "/growth-audit.css", "destination": "/web/styles.css" },
    { "source": "/growth-audit.js", "destination": "/web/app.js" },
    { "source": "/api/growth-audit", "destination": "/api/growth_audit" }
  ],
  "functions": {
    "api/growth_audit.py": {
      "maxDuration": 30,
      "excludeFiles": "{tests/**,docs/**,.github/**,web/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
